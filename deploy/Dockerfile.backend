# BuildHub backend — hardened multi-stage build.
# Build context must be the repo root: `docker build -f deploy/Dockerfile.backend .`

# ---- Build stage ----
FROM node:22-bookworm-slim AS build
WORKDIR /app/backend

# Prisma needs OpenSSL (and libssl) to detect the engine target and run.
# node:*-slim ships without it, so install it explicitly.
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

# Install deps (incl. dev) using the lockfile for reproducibility.
COPY backend/package.json ./
COPY package-lock.json /app/
RUN npm install --no-audit --no-fund

COPY backend/ ./
# Prisma client + TypeScript build.
RUN npx prisma generate && npm run build && npm prune --omit=dev

# ---- Runtime stage ----
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app/backend

# OpenSSL is required at runtime too (prisma migrate deploy + query engine).
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

# Run as the built-in unprivileged `node` user, not root.
# Uploads dir is owned by that user so local storage works.
COPY --from=build --chown=node:node /app/backend/node_modules ./node_modules
COPY --from=build --chown=node:node /app/backend/dist ./dist
COPY --from=build --chown=node:node /app/backend/prisma ./prisma
COPY --from=build --chown=node:node /app/backend/package.json ./package.json
RUN mkdir -p /app/backend/uploads && chown -R node:node /app/backend/uploads

USER node
EXPOSE 3001

# Apply migrations on boot, then start. Use `migrate deploy` (not `db push`) in prod.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
