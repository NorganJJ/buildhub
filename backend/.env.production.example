# BuildHub backend — PRODUCTION environment template.
# Copy to .env (or inject via your secrets manager) and fill in real values.
# NEVER commit the filled-in file.

# --- Core ---
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Public origins. CLIENT_URL must be the EXACT production frontend origin (used for
# CORS + OAuth redirects). API_URL is this server's public base URL.
CLIENT_URL=https://buildhub.example.com
API_URL=https://buildhub.example.com

# --- Database ---
# Use a strong password; do not expose Postgres to the public internet.
DATABASE_URL="postgresql://buildhub:CHANGE_ME_STRONG_PASSWORD@db:5432/buildhub_db"

# --- Secrets ---
# Generate each independently:  openssl rand -hex 64
# The app refuses to boot in production if these are weak, default, or equal.
JWT_ACCESS_SECRET=__generate_64_byte_hex__
JWT_REFRESH_SECRET=__generate_DIFFERENT_64_byte_hex__
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Signs short-lived download URLs. If unset, falls back to JWT_ACCESS_SECRET —
# set a dedicated secret in production.
DOWNLOAD_SECRET=__generate_64_byte_hex__

# --- File storage ---
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/backend/uploads
MAX_FILE_SIZE_MB=500
# For production scale, prefer S3:
# STORAGE_TYPE=s3
# AWS_BUCKET=buildhub-files
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Upload malware scanning ---
# 'none' = accept files as clean (default). Wire a real scanner before public uploads.
SCAN_PROVIDER=none

# --- Breached-password check (Have I Been Pwned) ---
# Leave unset to keep it ON. Set to 1 to disable (e.g. air-gapped deploys).
# DISABLE_HIBP=1

# --- Email (transactional: verification, password reset) ---
RESEND_API_KEY=re_your_real_key
FROM_EMAIL=BuildHub <noreply@buildhub.example.com>

# --- OAuth providers ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
